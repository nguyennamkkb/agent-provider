{
  "name": "ios-sdk-mcp",
  "version": "0.4.0",
  "description": "MCP server reading Apple SDK sources directly (no index): search, detail, members, source, grep",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ios-sdk-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build-index": "tsx src/build-index.ts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
